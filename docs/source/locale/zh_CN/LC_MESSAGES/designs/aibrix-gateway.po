msgid ":doc:`../features/gateway-routing/gateway-plugins`"
msgstr ":doc:`../features/gateway-routing/gateway-plugins`"

#: ../../source/designs/aibrix-gateway.rst:177
msgid "Configuring the gateway and choosing a routing strategy."
msgstr "配置网关并选择路由策略。"

